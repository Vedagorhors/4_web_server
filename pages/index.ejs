<!-- EJS - это простой язык шаблонов, позволяющий генерировать HTML-разметку с помощью обычного JavaScript -->
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Вставляем параметр title -->
    <title><%= title %></title>
  </head>
  <body>
    <% if (created) {%>
    <div class="alert alert-success">Note has been created!</div>
    <% } %>

    <div class="container">
      <h1><%= title %></h1>
      <!-- создадим интерфейс, который позволит из браузера создавать определенные заметки -->
      <form action="/" method="post" class="mb-2">
        <div class="form-group mb-2">
          <!-- чтобы мы не могли отправлять пустой input, допишем поле required -->
          <input type="text" class="form-control" name="title" required />
        </div>
        <!-- браузер будет понимать, что при нажатии на кнопку с типом submit будет перезагружена страница и отправлена форма -->
        <button class="btn btn-primary" type="submit">Create!</button>
      </form>

      <!-- Каждая заметка будет лежать в li с классом list-group-item -->
      <% if (notes.length) { %>
      <div class="card">
        <ul class="list-group">
          <!-- так как notes  у нас массив, то нужно сделать итерацию по массиву -->
          <% for (let i = 0; i < notes.length; i++) { %>
          <li
            class="list-group-item d-flex justify-content-between align-items-center"
          >
            <!-- Выводим название текущей заметки -->
            <!-- поместим название в span, чтобы при редактировании менять только текст, а кнопки оставить -->
            <span data-note-title><%= notes[i].title %></span>
            <div class="d-flex gap-2 ms-3">
              <!-- по data-type определим действие, а по data-id найдем нужную заметку на сервере -->
              <button
                type="button"
                class="btn btn-primary"
                data-type="edit"
                data-id="<%= notes[i].id %>"
              >
                Редактировать
              </button>
              <!-- для реализации удаления заметки создадим кнопку -->
              <button
                class="btn btn-danger"
                data-type="remove"
                data-id="<%= notes[i].id %>"
              >
                &times;
              </button>
            </div>
          </li>
          <% } %>
        </ul>
      </div>
      <% } else { %>
      <p>No notes!</p>
      <% } %>
    </div>

    <script src="/app.js"></script>
  </body>
</html>
